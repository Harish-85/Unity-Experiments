void GetCenterAndBasis(float3 v0, float3 v1, float3 v2, out float3 center, out float3 normal, out float3 tangent)
{
    float3 edge1 = v1 - v0;
    float3 edge2 = v2 - v0;
    normal = normalize(cross(edge1, edge2));
    center = (v0 + v1 + v2) / 3.0f;
    tangent = normalize(edge1);
}

